# Base de datos (contraseña del usuario sa de SQL Server: 8+ caracteres con mayúsculas, minúsculas y números)
SQL_SA_PASSWORD=Ejemplo_SqlServer_2026

# JWT (mínimo 32 caracteres; genera tu propio valor aleatorio)
JWT_SECRET=ejemplo-clave-jwt-cambiala-por-una-aleatoria-de-32-o-mas
JWT_ISSUER=PCBuilderOps
JWT_AUDIENCE=PCBuilderOps
JWT_EXPIRACION_MINUTOS=60

# URL pública de los enlaces de activación y recuperación
APP_BASE_URL=http://localhost:5206

# Administrador inicial (contraseña: 8+ caracteres con letras y números)
ADMIN_NOMBRE=Administrador PCBuilderOps
ADMIN_CORREO=admin@pcbuilderops.com
ADMIN_PASSWORD=Admin12345

# Correo saliente. El host de ejemplo no existe: los correos quedan Pendiente en la cola
# hasta que pongas un servidor real (Gmail: smtp.gmail.com, puerto 587, contraseña de aplicación).
SMTP_HOST=smtp.ejemplo.invalid
SMTP_PORT=587
SMTP_USER=tu-correo@ejemplo.com
SMTP_PASS=tu-contrasena-de-aplicacion
SMTP_FROM=tu-correo@ejemplo.com
EMAIL_WORKER_INTERVALO_SEGUNDOS=30

# API externa de tasa de cambio (https://www.exchangerate-api.com). Con este valor de ejemplo,
# la conversión de moneda responde un rechazo controlado y el resto del proyecto funciona.
TASA_CAMBIO_API_KEY=tu-clave-de-exchangerate-api
